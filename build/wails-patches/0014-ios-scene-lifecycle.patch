+- (void)installWindow:(UIWindow *)window {
+    // Start the window with the launch-screen colour (a "LaunchBackground"
+    // colour asset, also referenced by UILaunchScreen) so there's no white
+    // flash between the launch screen and the first WebView paint. The Go
+    // options set the colour too, but that happens after the Go runtime starts,
+    // so it can't colour the initial window. Falls back to white if the
+    // asset isn't present.
+    UIColor *background = [UIColor colorNamed:@"LaunchBackground"] ?: [UIColor whiteColor];
+    unsigned char r = 255, g = 255, b = 255, a = 255;
+    if (ios_get_app_background_color(&r, &g, &b, &a)) {
+        background = [UIColor colorWithRed:r / 255.0 green:g / 255.0 blue:b / 255.0 alpha:a / 255.0];
+    }
+    window.backgroundColor = background;
+    // A scene UIKit discarded in the background reconnects with a new window,
+    // which takes over the WebView the Go runtime already created.
+    if (self.viewControllers.count > 0) {
+        window.rootViewController = self.viewControllers.firstObject;
+    } else {
+        UIViewController *placeholder = [[UIViewController alloc] init];
+        placeholder.view.backgroundColor = background;
+        window.rootViewController = placeholder;
+    }
+    self.window = window;
+    [window makeKeyAndVisible];
+}
