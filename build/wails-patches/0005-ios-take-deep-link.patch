+// MARK: - Deep links
+
+// Only touched on the main thread: UIKit delivers the link there and the take
+// hops onto it.
+static NSString *g_mfPendingDeepLink = nil;
+
+void ios_receive_deep_link(const char* curl) {
+    if (curl == NULL) return;
+    g_mfPendingDeepLink = [NSString stringWithUTF8String:curl];
+    extern void iosEmitNativeEvent(const char* name, const char* json);
+    iosEmitNativeEvent("ios:deeplink", "{}");
+}
+
+const char* ios_take_deep_link(void) {
+    __block NSString *link = nil;
+    mfRunOnMainSync(^{
+        link = g_mfPendingDeepLink;
+        g_mfPendingDeepLink = nil;
+    });
+    return mfDup(link);
+}
