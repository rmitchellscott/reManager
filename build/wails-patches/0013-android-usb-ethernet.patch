+// OpenUSBEthernet claims an attached USB CDC-ECM device for a userspace network
+// stack when no Android network reaches the address. JSON: {"address"}.
+// Returns {"routed":true}, {"absent":true}, {"error"} or
+// {"fd","in","out","maxPacket"}.
+func (androidManager) OpenUSBEthernet(jsonPayload string) string {
+	s, _ := androidBridgeStringString("openUsbEthernet", jsonPayload)
+	return s
+}
+
+// CloseUSBEthernet releases the device OpenUSBEthernet claimed.
+func (androidManager) CloseUSBEthernet() {
+	androidBridgeVoid("closeUsbEthernet")
+}
