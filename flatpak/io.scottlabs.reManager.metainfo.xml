<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.scottlabs.reManager</id>
  <name>reManager</name>
  <summary>Manage mods on reMarkable tablets</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.scottlabs">
    <name>Mitchell Scott</name>
  </developer>
  <description>
    <p>
      A multi-platform desktop app for managing mods on reMarkable tablets.
      Powered by the Vellum package manager.
    </p>
    <p>Features:</p>
    <ul>
      <li>Multi-device management: Save multiple sets of SSH credentials with password or key-based authentication</li>
      <li>Mod management: Browse, install, upgrade, and remove mods with automatic dependency resolution</li>
      <li>System tools: Turn automatic updates on or off, set the timezone, and run mod-provided scripts</li>
      <li>Interactive terminal: Access a complete shell session on your reMarkable</li>
      <li>File Browser: Browse the filesystem and transfer files to and from your reMarkable</li>
      <li>Backup and restore: Back up and restore your document library and configuration</li>
      <li>Configuration editor: Edit system configuration files with syntax highlighting</li>
    </ul>
  </description>
